---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (name: string) => `${base}/images/${name}.webp`;

const glance = [
  ['91%', 'Fewer clicks', 'Across the measured store setup workflow.'],
  ['79%', 'Task success', 'Up from 40% in the earlier benchmark.'],
  ['55%', 'Less time on task', 'From 71:26 to 32:12 in usability benchmarking.'],
];
const concepts = [
  ['Commerce Setup', 'Automated configuration and guided setup.', 'd2c-concept-setup', 'Wireframe concept for automated Commerce setup with a checklist of mandatory steps'],
  ['Commerce App', 'Simplified navigation, onboarding, and task discovery.', 'd2c-concept-app', 'Wireframe concept for the Commerce App with store overview and onboarding steps'],
];
const flow = ['Explore', 'Prototype', 'Test', 'Align'];
const findings = [
  ['41', 'E-commerce professionals in the benchmark.'],
  ['60+ minutes', 'Required by many participants attempting complex setup tasks.'],
  ['0', 'Participants completed every tested task successfully.'],
];
const principles = [
  ['Automate the Essentials', 'Handle required configuration so merchants can start using the product sooner.'],
  ['Smart Defaults', 'Establish sensible configurations that reduce manual decisions.'],
  ['Progressive Disclosure', 'Introduce advanced capabilities when they’re relevant.'],
  ['Task-Oriented Discovery', 'Organize functionality around the jobs merchants need to accomplish.'],
];
const anatomy = [
  ['Store Switcher', 'Manage and move between stores.'],
  ['Navigation Hierarchy', 'Organize functionality into predictable sections.'],
  ['Persistent Tools', 'Keep essential actions accessible.'],
  ['Workspace', 'Provide a consistent environment for completing tasks.'],
];
const outcomes = [
  ['Task Success', '40%', '79%', '39 percentage-point increase.'],
  ['Time on Task', '71:26', '32:12', 'Approximately 55% reduction.'],
  ['Ease of Use', '3.3', '4.4', '1.1-point improvement on a seven-point scale.'],
];
const stages = [
  ['Vision', 'Initial sprint concepts and prototypes.', 'd2c-concept-app', 'Initial Commerce App concept'],
  ['Strategy', 'Shared UX principles and experience architecture.', 'd2c-anatomy', 'Navigation anatomy diagram'],
  ['Execution', 'Commerce Setup and navigation designs.', 'd2c-setup-after', 'Redesigned Commerce setup'],
  ['Impact', 'Validated improvements in usability and task performance.', '', ''],
];
const highlights = [
  ['Product Vision', 'Helped define a commerce experience for a new market segment.'],
  ['Executive Influence', 'Secured support for a direction that expanded into a year-long initiative.'],
  ['Cross-Functional Leadership', 'Led UX across product, engineering, and research.'],
  ['Design Craft', 'Translated complex workflows into polished, intuitive experiences.'],
  ['Measurable Impact', 'Connected design decisions with significant improvements in customer usability.'],
];
---
<div class="d2c">
  <!-- Impact at a glance -->
  <section class="sec first">
    <p class="eyebrow">Impact at a Glance</p>
    <ul class="glance">
      {glance.map(([n, t, d]) => <li><strong>{n}</strong><h3>{t}</h3><p>{d}</p></li>)}
    </ul>
    <p class="note">Source: Salesforce Commerce usability research, 2023–2024.</p>
  </section>

  <!-- 01 -->
  <section class="sec">
    <p class="eyebrow">01 · The Breakthrough</p>
    <h2>Five Days to Define a New Direction</h2>
    <div class="copy">
      <p>I was invited to join a cross-functional design sprint to reimagine Commerce for midmarket customers, a new market segment for Salesforce.</p>
      <p>Over five days, we explored several approaches to simplifying store setup and navigation.</p>
      <p>Following the sprint, I partnered with a senior designer to prototype, refine, and test multiple concepts.</p>
      <p>We presented the resulting vision to executive leadership and secured support to move forward.</p>
      <p>What began as a five-day sprint became the foundation for a year-long product transformation.</p>
    </div>
    <ul class="duo">
      {concepts.map(([t, d, i, alt]) => (
        <li><figure><img src={img(i)} alt={alt} loading="lazy" /></figure><h3>{t}</h3><p>{d}</p></li>
      ))}
    </ul>
    <ol class="flow">
      {flow.map((s, i) => <li><span class="num">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
    </ol>
    <p class="callout">A five-day sprint established the direction for a year of product development.</p>
  </section>

  <!-- 02 -->
  <section class="sec">
    <p class="eyebrow">02 · The Business Opportunity</p>
    <h2>Bringing Enterprise Commerce to a New Market</h2>
    <div class="opp">
      <div class="copy">
        <p>Salesforce Commerce Cloud was designed to support large enterprises with complex needs and dedicated implementation teams.</p>
        <p>Expanding into the midmarket meant serving businesses with fewer resources and a greater need for speed and simplicity.</p>
        <p>The existing setup experience presented a significant barrier.</p>
        <p>Merchants had to navigate complex configurations, consult extensive documentation, and understand the platform before they could start using it.</p>
        <p>The opportunity was to make enterprise-grade commerce easier to adopt.</p>
      </div>
      <div class="shift" role="img" aria-label="Diagram: from enterprise, with dedicated implementation teams and complex needs, to the midmarket, with fewer resources and a need for speed and simplicity">
        <div class="shift-row"><span class="shift-label">Enterprise</span><span>Dedicated implementation teams</span><span>Complex needs</span></div>
        <div class="shift-arrow" aria-hidden="true">&darr;</div>
        <div class="shift-row"><span class="shift-label">Midmarket</span><span>Fewer resources</span><span>Speed and simplicity</span></div>
      </div>
    </div>
  </section>

  <!-- 03 -->
  <section class="sec">
    <p class="eyebrow">03 · The Research</p>
    <h2>Understanding What Was Slowing Customers Down</h2>
    <div class="copy">
      <p>Competitive benchmarking with 41 e-commerce professionals revealed significant usability challenges.</p>
      <p>Complex setup tasks frequently took more than an hour, and participants struggled to identify where to begin.</p>
      <p>Unclear navigation and frequent context switching contributed to frustration, task abandonment, and unsuccessful outcomes.</p>
      <p>The research gave us a clear direction: simplify setup, reduce unnecessary decisions, and help merchants accomplish their goals.</p>
    </div>
    <ul class="three stats">
      {findings.map(([n, d], i) => (
        <li>
          <div class="viz" aria-hidden="true">
            {i === 1
              ? <div class="track"><span class="bar"></span><span class="tick t0">0</span><span class="tick t60">60 min</span></div>
              : <div class={`dots${i === 2 ? ' hollow' : ''}`}>{Array.from({ length: 41 }, () => <svg viewBox="0 0 12 14"><circle cx="6" cy="3.5" r="2.75" /><path d="M0.75 13.25c0-3.1 2.35-5.25 5.25-5.25s5.25 2.15 5.25 5.25z" /></svg>)}</div>}
          </div>
          <strong>{n}</strong><p>{d}</p>
        </li>
      ))}
    </ul>
    <p class="callout">Finding where to begin was a major barrier to completing the work.</p>
  </section>

  <!-- 04 -->
  <section class="sec">
    <p class="eyebrow">04 · The UX Strategy</p>
    <h2>Simplifying the Path to Value</h2>
    <div class="copy">
      <p>The initial concepts established a broader experience strategy: help merchants get started quickly and make essential capabilities easy to use.</p>
      <p>I led the UX direction around four principles that guided the redesign across teams.</p>
    </div>
    <ol class="four">
      {principles.map(([t, d], i) => <li><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>)}
    </ol>
    <p class="callout">A shared UX framework for reducing complexity across Commerce Cloud.</p>
  </section>

  <!-- 05 -->
  <section class="sec">
    <p class="eyebrow">05 · The Setup Transformation</p>
    <h2>From Configuration to Commerce</h2>
    <div class="copy">
      <p>The existing setup process required merchants to complete numerous technical steps before they could begin operating their store.</p>
      <p>We redesigned the experience around automation, smart defaults, and clearer guidance.</p>
      <p>Essential configuration could happen with fewer manual decisions, while advanced capabilities remained available when needed.</p>
      <p>The result was a dramatically shorter path to a working commerce environment.</p>
    </div>
    <figure class="big"><video src={`${base}/images/d2c-setup-home.mp4`} poster={img('d2c-setup-home')} autoplay muted loop playsinline preload="auto" aria-label="Redesigned Commerce Setup: the merchant opens Set Up the Basics and runs setup automation"></video></figure>
  </section>

  <!-- 06 -->
  <section class="sec">
    <p class="eyebrow">06 · The Impact of Simplification</p>
    <h2>2,000+ Clicks Eliminated</h2>
    <div class="copy">
      <p>By automating mandatory configuration, introducing smart defaults, and simplifying the setup experience, we substantially reduced the effort required to get started.</p>
    </div>
    <p class="huge"><strong>91%</strong><span>Reduction in clicks across the measured setup workflow.</span></p>
    <p class="sub">More than 2,000 clicks eliminated through automation, simplification, and predefined configuration.</p>
  </section>

  <!-- 07 -->
  <section class="sec">
    <p class="eyebrow">07 · The Commerce App</p>
    <h2>An Experience Built Around Merchant Goals</h2>
    <div class="copy">
      <p>Simplifying setup was the first step.</p>
      <p>Merchants also needed an intuitive environment for managing their business after launch.</p>
      <p>I led the design of a new Commerce App that connected onboarding, navigation, and everyday operations.</p>
      <p>The redesigned experience brought together store management, actionable tasks, and relevant business information in a consistent workspace.</p>
      <p>Merchants could understand what needed attention and quickly access the tools required to move forward.</p>
    </div>
    <figure class="big small"><img src={img('d2c-app-before')} alt="Original Commerce App with store overview and import window" loading="lazy" /><figcaption><strong>Before</strong>Original Commerce App navigation and onboarding.</figcaption></figure>
    <figure class="big"><img src={img('d2c-app-after')} alt="Redesigned Commerce App dashboard with a Total Orders chart opened from a metric card" loading="lazy" /><figcaption><strong>After</strong>Redesigned dashboard with store navigation, performance metrics, actionable tasks, and recent activity.</figcaption></figure>
  </section>

  <!-- 08 -->
  <section class="sec">
    <p class="eyebrow">08 · Designing for Scale</p>
    <h2>A Consistent Framework Across Commerce</h2>
    <div class="copy">
      <p>The new Commerce App needed to support multiple stores, distinct product areas, and expanding functionality.</p>
      <p>I developed a navigation framework that established consistent patterns for store selection, navigation hierarchy, persistent tools, and the main workspace.</p>
      <p>The framework connected onboarding and day-to-day operations within a cohesive experience.</p>
    </div>
    <div class="split anat">
      <figure><img src={img('d2c-anatomy')} alt="Navigation anatomy with eleven numbered parts, from store switcher to work area" loading="lazy" /></figure>
      <ul class="plain">
        {anatomy.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- 09 -->
  <section class="sec">
    <p class="eyebrow">09 · Validated Outcomes</p>
    <h2>Measurable Improvements in Usability</h2>
    <div class="copy">
      <p>Follow-up research demonstrated substantial improvements in how merchants completed common Commerce tasks.</p>
      <p>Compared with the earlier Salesforce experience, the redesigned product enabled higher task success, faster completion, and improved ease of use.</p>
    </div>
    <ul class="three outcomes">
      {outcomes.map(([t, a, b, d]) => (
        <li><span class="num">{t}</span><strong><i>{a}</i> <em>→</em> {b}</strong><p>{d}</p></li>
      ))}
    </ul>
    <p class="note">Salesforce Commerce usability benchmarking, 2023 baseline and 2024 validation.</p>
    <div class="copy tail">
      <p>Testing showed that users could locate previously created items, understood the store switcher, and navigated secondary and tertiary items successfully.</p>
      <p>These findings supported the effectiveness of the redesigned navigation and onboarding experience.</p>
    </div>
  </section>

  <!-- 10 -->
  <section class="sec">
    <p class="eyebrow">10 · Design Leadership</p>
    <h2>From Design Sprint to Product Transformation</h2>
    <div class="copy">
      <p>What began as a five-day design sprint became a year-long initiative spanning multiple teams and product areas.</p>
      <p>I helped establish the initial vision, secured executive support, and led UX across Commerce Setup, navigation, and onboarding.</p>
      <p>The work required aligning product, engineering, research, and design around a shared experience strategy while translating ambitious concepts into production-ready solutions.</p>
      <p>The resulting improvements validated the direction and helped influence the broader Commerce platform roadmap.</p>
    </div>
    <ol class="four prog">
      {stages.map(([t, d, i, alt], n) => (
        <li>
          {i ? <figure><img src={img(i)} alt={alt} loading="lazy" /></figure> : <div class="metric"><i>40%</i><em>→</em><b>79%</b></div>}
          <span class="num">{String(n + 1).padStart(2, '0')}</span>
          <h3>{t}</h3>
          <p>{d}</p>
        </li>
      ))}
    </ol>
    <ul class="high">
      {highlights.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
    </ul>
  </section>

  <!-- 11 -->
  <section class="sec last">
    <p class="eyebrow">11 · Reflection</p>
    <h2>Making Powerful Products Accessible</h2>
    <div class="copy">
      <p>This project reinforced how much impact foundational UX improvements can have on an enterprise product.</p>
      <p>By simplifying configuration, reducing unnecessary decisions, and organizing the experience around merchant goals, we created a more approachable path into Commerce Cloud.</p>
      <p>The work began with a focused vision and evolved into a broader product transformation, supported by measurable improvements in usability.</p>
    </div>
    <figure class="big"><video src={`${base}/images/d2c-new-product-v2.mp4`} poster={img('d2c-new-product')} autoplay muted loop playsinline preload="auto" aria-label="The redesigned Commerce App in use"></video></figure>
    <blockquote>The greatest impact often comes from making complexity feel effortless.</blockquote>
  </section>

  <dialog class="lb" aria-label="Enlarged image">
    <img alt="" />
    <button type="button" class="nav prev" aria-label="Previous image">&larr;</button>
    <button type="button" class="nav next" aria-label="Next image">&rarr;</button>
  </dialog>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.d2c');
  const lb = root?.querySelector<HTMLDialogElement>('.lb');
  if (root && lb) {
    const big = lb.querySelector('img')!;
    const prev = lb.querySelector<HTMLButtonElement>('.prev')!;
    const next = lb.querySelector<HTMLButtonElement>('.next')!;
    let group: HTMLImageElement[] = [];
    let at = 0;
    const show = (i: number) => {
      at = (i + group.length) % group.length;
      big.src = group[at].currentSrc || group[at].src;
      big.alt = group[at].alt;
      prev.hidden = next.hidden = group.length < 2;
    };
    root.querySelectorAll<HTMLImageElement>('section img').forEach((im) => {
      im.tabIndex = 0;
      im.setAttribute('role', 'button');
      im.setAttribute('aria-label', `Enlarge: ${im.alt}`);
      const open = () => {
        group = [...im.closest('section')!.querySelectorAll<HTMLImageElement>('img')];
        show(group.indexOf(im));
        lb.showModal();
      };
      im.addEventListener('click', open);
      im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    });
    prev.addEventListener('click', (e) => { e.stopPropagation(); show(at - 1); });
    next.addEventListener('click', (e) => { e.stopPropagation(); show(at + 1); });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(at - 1);
      if (e.key === 'ArrowRight') show(at + 1);
    });
    lb.addEventListener('click', () => lb.close());
  }
</script>

<style>
  .d2c { --accent: var(--muted); }
  .sec { padding: 7rem 0; border-top: 1px solid var(--rule); }
  .sec.first { padding-top: 0; border-top: 0; }
  .eyebrow { margin: 0 0 1.25rem; font-size: 0.875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  h2 { margin: 0 0 3rem; max-width: 16ch; font-size: clamp(2.25rem, 5vw, 4.25rem); line-height: 1.02; letter-spacing: -0.04em; font-weight: 500; }
  h3 { margin: 0 0 0.5rem; font-size: clamp(1.25rem, 1.9vw, 1.6rem); line-height: 1.15; letter-spacing: -0.03em; font-weight: 500; }
  .copy { margin-bottom: 4rem; }
  .copy p { margin: 0 0 1rem; max-width: 34rem; }
  .copy.tail { margin: 4rem 0 0; }
  figure { margin: 0; }
  video { display: block; width: 100%; height: auto; margin: 0; border-radius: 16px; }
  img { display: block; width: 100%; height: auto; margin: 0; border-radius: 16px; cursor: zoom-in; }
  figcaption { margin-top: 0.75rem; color: var(--muted); font-size: 0.875rem; }
  figcaption strong { display: block; margin-bottom: 0.25rem; color: var(--fg); font-size: 1.1rem; font-weight: 500; letter-spacing: -0.02em; }
  .num { display: block; margin: 0 0 0.75rem; color: var(--muted); font-size: 0.875rem; letter-spacing: 0.06em; text-transform: uppercase; }
  ul, ol { list-style: none; padding: 0; margin: 0; }
  li p { margin: 0; color: var(--muted); max-width: 22rem; }
  .callout { margin: 4rem 0 0; max-width: 24ch; font-size: clamp(1.5rem, 2.8vw, 2.5rem); line-height: 1.1; letter-spacing: -0.035em; font-weight: 500; }
  .note { margin: 2rem 0 0; color: var(--muted); font-size: 0.875rem; max-width: none; }
  .big { margin-top: 4rem; }
  .big.small { max-width: 70%; }

  .glance { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; }
  .glance li { padding-top: 1.5rem; border-top: 2px solid var(--fg); }
  .glance strong, .stats strong { display: block; margin-bottom: 0.75rem; font-size: clamp(3.5rem, 8vw, 7rem); line-height: 1; letter-spacing: -0.05em; font-weight: 500; }
  .glance h3 { margin-bottom: 0.25rem; }

  .duo { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem; margin-bottom: 4rem; }
  .duo figure { margin-bottom: 1.25rem; }
  .flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .flow li { padding-top: 1.25rem; border-top: 2px solid var(--fg); font-size: clamp(1.25rem, 2vw, 1.75rem); letter-spacing: -0.03em; font-weight: 500; }

  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; }
  .three li { padding-top: 1.5rem; border-top: 2px solid var(--fg); }
  .viz { display: flex; align-items: flex-start; margin-bottom: 1.5rem; }
  .dots { display: grid; grid-template-columns: repeat(11, 1fr); gap: 8px 6px; width: 100%; max-width: 17rem; }
  .dots svg { display: block; width: 100%; height: auto; fill: var(--fg); stroke: none; }
  .dots.hollow svg { fill: none; stroke: var(--muted); stroke-width: 1; stroke-linejoin: round; }
  .track { position: relative; align-self: flex-end; margin-bottom: 1.1rem; width: 100%; height: 2.25rem; border-bottom: 1px solid var(--rule); }
  .bar { position: absolute; left: 0; bottom: 0; width: 100%; height: 1.25rem; border-radius: 0.625rem 0 0 0.625rem; background: linear-gradient(90deg, var(--fg) 0 60%, transparent); }
  .tick { position: absolute; top: 100%; margin-top: 0.4rem; color: var(--muted); font-size: 0.75rem; }
  .t0 { left: 0; }
  .t60 { left: 60%; transform: translateX(-50%); }

  @media (min-width: 1000px) {
    .stats { row-gap: 0; }
    .stats li { display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 0; }
    .stats .viz { align-items: flex-start; }
    .stats .track { align-self: end; }
  }
  .stats strong { font-size: clamp(2.5rem, 5.5vw, 4.75rem); }
  .four { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.5rem; }
  .four li { padding-top: 1.25rem; border-top: 2px solid var(--fg); }
  .four li p { max-width: none; font-size: 0.9375rem; }

  .huge { display: grid; gap: 1rem; margin: 0; }
  .huge strong { font-size: clamp(7rem, 22vw, 18rem); line-height: 0.85; letter-spacing: -0.06em; font-weight: 500; }
  .huge span { max-width: 30ch; font-size: clamp(1.25rem, 2.2vw, 1.75rem); letter-spacing: -0.02em; }
  .sub { margin: 2rem 0 0; max-width: 40rem; color: var(--muted); }

  .opp { display: grid; grid-template-columns: 7fr 4fr; gap: 4rem; align-items: start; }
  .opp .copy { margin-bottom: 0; }
  .shift { display: grid; gap: 1rem; }
  .shift-row { display: grid; gap: 0.25rem; padding-top: 1.25rem; border-top: 2px solid var(--fg); font-size: 1.1rem; letter-spacing: -0.02em; }
  .shift-row span:not(.shift-label) { color: var(--muted); font-size: 0.9375rem; letter-spacing: 0; }
  .shift-label { color: var(--fg); font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 500; letter-spacing: -0.035em; }
  .shift-arrow { color: var(--muted); font-size: 1.5rem; line-height: 1; }

  .split { display: grid; grid-template-columns: 7fr 5fr; gap: 4rem; align-items: center; }
  .plain { display: grid; gap: 2rem; }
  .plain li { padding-top: 1.25rem; border-top: 2px solid var(--fg); }
  .plain p { max-width: none; }

  .outcomes strong { display: block; margin-bottom: 0.75rem; font-size: clamp(2rem, 3.6vw, 3.25rem); line-height: 1.05; letter-spacing: -0.045em; font-weight: 500; }
  .outcomes i { font-style: normal; color: var(--muted); }
  .outcomes em { font-style: normal; color: var(--muted); }

  .prog { margin-bottom: 5rem; align-items: start; }
  .prog figure { margin-bottom: 1rem; }
  .metric { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 1rem; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.04em; font-weight: 500; }
  .metric i, .metric em { font-style: normal; color: var(--muted); }
  .metric b { font-weight: 500; }
  .high { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2rem; }
  .high li { padding-top: 1.25rem; border-top: 2px solid var(--fg); }
  .high h3 { font-size: 1.125rem; }
  .high p { font-size: 0.9375rem; }

  .last { padding-bottom: 2rem; }
  blockquote { margin: 5rem 0 0; max-width: 22ch; font-size: clamp(2rem, 4.6vw, 3.75rem); line-height: 1.08; letter-spacing: -0.04em; font-weight: 500; }

  .lb { padding: 0; border: 0; background: transparent; max-width: 94vw; max-height: 94vh; overflow: visible; }
  .lb::backdrop { background: rgba(0, 0, 0, 0.88); }
  .nav { position: fixed; top: 50%; transform: translateY(-50%); width: 3.25rem; height: 3.25rem; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.92); color: #000; font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .nav:hover, .nav:focus-visible { background: #fff; outline: 2px solid var(--accent); }
  .nav[hidden] { display: none; }
  .prev { left: 1.5rem; }
  .next { right: 1.5rem; }
  .lb img { width: auto; max-width: 94vw; max-height: 94vh; margin: 0; cursor: zoom-out; background: #fff; border-radius: 0; }

  @keyframes rise { from { opacity: 0; transform: translateY(2.5rem); } to { opacity: 1; transform: none; } }
  h2, figure, .glance li, .three li, .four li, .flow li, .high li, .callout, blockquote, .huge {
    animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 35%;
  }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }

  @media (max-width: 999px) {
    .sec { padding: 4.5rem 0; }
    .glance, .duo, .three, .split, .opp { grid-template-columns: 1fr; gap: 2.5rem; }
    .four, .flow { grid-template-columns: repeat(2, 1fr); }
    .high { grid-template-columns: 1fr 1fr; }
    .big.small { max-width: none; }
  }
</style>
