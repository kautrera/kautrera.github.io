---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hidden = ['about', 'contact', 'consulting', 'custom-apps', 'truecar', 'ello', 'blue-coat', 'photobucket', 'palette'];
// Email is shipped base64-encoded and assembled in the browser, so scrapers reading raw HTML never see it.
const emailToken = Buffer.from('karen.utera@gmail.com').toString('base64');
// Wall position keeps an older project's former date, so changing a shown year doesn't reshuffle the wall.
const stamp = (p) => (p.id === 'truecar-1' ? new Date('2021-07-01') : p.data.date).getTime();
const projects = (await getCollection('pages'))
  .filter((p) => !p.data.draft && !p.data.protected && !hidden.includes(p.id))
  .sort((a, b) => stamp(b) - stamp(a));

// The Squarespace import left near-duplicate pages; keep the newest per title.
const seen = new Set();
// Where to anchor the cover crop per project (CSS object-position).
const focus = { 'roadster-1': 'right center' };

// Freelance banners from the old Squarespace gallery. Titles are guessed from the file names, edit freely.
const cover = { clippit: '/images/664169-banner3-clippit.jpg' };
const freelance = [
  ['Ello', '5dbae5-banner3-ello.jpg', 2007, 'ello'],
  ['Photobucket', '4713ce-1-pb.png', 2010, 'photobucket'],
  ['Blue Coat', 'a8ddd9-banner1-bc.jpg', 2009, 'blue-coat'],
].map(([title, file, year, id]) => ({ id, title, year, image: `/images/${file}` }));

const wall = projects
  .filter((p) => !seen.has(p.data.title) && seen.add(p.data.title))
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    year: p.data.year ?? p.data.date.getFullYear(),
    focus: focus[p.id],
    // Animated GIFs get a static `-still.png` next to them for the wall.
    image: cover[p.id] ?? p.body?.match(/!\[[^\]]*\]\((\/images\/[^)\s]+)\)/)?.[1]?.replace(/\.gif$/, '-still.png'),
  }))
  .concat(freelance);

// Tiles listed here come first, in this order; the rest keep their date order.
const order = ['roadster-1', 'b2b-commerce'];
const rank = (t) => (order.includes(t.id) ? order.indexOf(t.id) : order.length);
wall.sort((a, b) => rank(a) - rank(b));

// Current projects, placeholders until case studies exist. Add `image` and `id` to link one.
const current = [
  { id: 'custom-apps', title: 'Custom Apps', image: '/images/custom-apps.webp' },
  { id: 'bm-ux-studio', title: 'BM UX Studio', image: '/images/bm-ux-studio.webp' },
  { title: 'Commerce D2C', year: 2022 },
  { id: 'commerce-studio', title: 'Commerce Studio', image: '/images/commerce-studio-login.webp' },
].map((c, i) => ({ tone: i % 4, ...(typeof c === 'string' ? { title: c } : c) }));

const tiles = [];
for (let i = 0; i < Math.max(current.length, wall.length); i++) {
  if (current[i]) tiles.push(current[i]);
  if (wall[i]) tiles.push(wall[i]);
}

// Swap Commerce Studio into the B2B Commerce slot.
const a = tiles.findIndex((t) => t.title === 'Commerce Studio');
const b = tiles.findIndex((t) => t.id === 'b2b-commerce');
if (a > -1 && b > -1) [tiles[a], tiles[b]] = [tiles[b], tiles[a]];

// Palette leads the wall; everything else shifts one place right.
tiles.unshift({ id: 'palette', mark: true, title: 'Palette', year: 2026, tone: 0 });

// Placeholder copy, edit freely.
const audiences = [
  { id: 'anyone', label: 'For anyone', text: 'Hi there, I’m Karen, a product designer who cares about creating tools people enjoy using.' },
  { id: 'recruiters', label: 'Recruiters', text: 'I’m a Principal Product Designer at Salesforce, leading UX for Commerce Cloud. Open to conversations about staff and principal design roles.' },
  { id: 'directors', label: 'Design Directors', text: 'I design complex, system-level tools, then prototype them in code so the handoff to engineering is something you can click.' },
  { id: 'pms', label: 'Product Managers', text: 'I turn fuzzy asks into clear patterns, write the acceptance criteria with you, and keep the user in the room.' },
  { id: 'engineers', label: 'Engineers', text: 'I hand you working prototypes, not static mockups. Expect real states, real tokens, and fewer surprises at review.' },
];
---
<Base title="Portfolio">
  <section id="intro">
  <div class="audience" role="tablist" aria-label="Read this site as">
    {audiences.map((a, i) => (
      <button type="button" role="tab" data-id={a.id} aria-selected={i === 0} class:list={[{ on: i === 0 }]}>{a.label}</button>
    ))}
  </div>
  <h1 id="hero">{audiences[0].text}</h1>
  </section>

  <section id="work">
    <ul class="wall">
      {tiles.map((t) => {
        const inner = t.mark
          ? (
            <span class="palmark" aria-hidden="true">
              <span class="palicon">
                <svg viewBox="0 0 32 32" width="52%">
                  <mask id="pal-hole" maskUnits="userSpaceOnUse" x="0" y="0" width="32" height="32">
                    <rect width="32" height="32" fill="#fff" />
                    <circle cx="6.75" cy="25.5" r="2" fill="#000" />
                  </mask>
                  <g mask="url(#pal-hole)">
                    <rect x="2.75" y="3" width="8" height="24.5" rx="3" fill="#8183c5" transform="rotate(28 6.75 25.5)" />
                    <rect x="2.75" y="3" width="8" height="24.5" rx="3" fill="#5a63b6" transform="rotate(59 6.75 25.5)" />
                    <rect x="2.75" y="3" width="8" height="24.5" rx="3" fill="#8183c5" transform="rotate(90 6.75 25.5)" />
                    <rect x="2.5" y="2.5" width="8.5" height="27" rx="2.9" fill="#464c8e" />
                  </g>
                </svg>
              </span>
            </span>
          )
          : t.image
          ? <img src={base + t.image} alt={t.title} loading="lazy" style={t.focus ? `object-position: ${t.focus}` : undefined} />
          : <span class="blank">{t.title}</span>;
        const info = (
          <span class="info"><span class="name">{t.title}</span><span class="year">{t.year ?? 'Current'}</span></span>
        );
        return (
          <li class={`tone-${t.tone ?? 'x'}`}>
            {t.id
              ? <a href={`${base}/${t.id}/`} aria-label={t.title}>{inner}{info}</a>
              : <div class="tile">{inner}{info}</div>}
          </li>
        );
      })}
    </ul>
  </section>

  <section id="about">
    <h2>About</h2>
    <p>I’m a Principal Product Designer at Salesforce, leading UX for Commerce Cloud. I design the tools merchants use to build their storefronts and manage complex commerce operations.</p>
    <p>I like turning complex, system-level problems into clear patterns, then prototyping them in code so teams can click through the idea before it ships.</p>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>Say hello at <a href="#contact" id="email" data-token={emailToken}>my email (needs JavaScript)</a>.</p>
  </section>

  <script is:inline>
    const mail = document.getElementById('email');
    const address = atob(mail.dataset.token);
    mail.href = 'mailto:' + address;
    mail.textContent = address;
  </script>

  <script is:inline define:vars={{ audiences }}>
    const hero = document.getElementById('hero');
    const tabs = document.querySelectorAll('.audience button');
    const select = (id) => {
      const a = audiences.find((x) => x.id === id);
      if (!a) return;
      hero.textContent = a.text;
      tabs.forEach((t) => {
        const on = t.dataset.id === id;
        t.classList.toggle('on', on);
        t.setAttribute('aria-selected', on);
      });
      localStorage.setItem('audience', id);
    };
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.id)));
    select(localStorage.getItem('audience') || 'anyone');
  </script>

  <style>
    .audience { display: flex; flex-wrap: wrap; gap: 0.25rem 2rem; margin: 0 0 1rem; }
    .audience button {
      all: unset; cursor: pointer; color: var(--muted); transition: color 0.15s;
    }
    .audience button:hover, .audience button.on { color: var(--fg); }
    .audience button:focus-visible { outline: 2px solid var(--fg); outline-offset: 4px; }
    .wall { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
    .wall li { position: relative; max-width: none; aspect-ratio: 4 / 3; overflow: hidden; background: var(--chip); transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s; }
    .wall li:hover, .wall li:focus-within { transform: scale(1.12); z-index: 2; box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.35); }
    .wall a, .wall .tile { display: grid; place-items: center; width: 100%; height: 100%; color: var(--fg); text-decoration: none; }
    .palmark { position: relative; display: grid; place-items: center; width: 100%; height: 100%; overflow: hidden; background: #14161f; }
    .palmark::before {
      content: ''; position: absolute; inset: -20%; filter: blur(28px);
      background:
        radial-gradient(38% 42% at 18% 22%, #c9b79f 0%, transparent 100%),
        radial-gradient(40% 45% at 82% 20%, #1d2b2c 0%, transparent 100%),
        radial-gradient(34% 38% at 28% 82%, #e9e1d3 0%, transparent 100%),
        radial-gradient(42% 46% at 78% 78%, #8183c5 0%, transparent 100%),
        radial-gradient(36% 40% at 55% 50%, #464c8e 0%, transparent 100%);
    }
    .palicon {
      position: relative; z-index: 1; display: grid; place-items: center; width: 34%; aspect-ratio: 1; border-radius: 22%;
      background: rgba(255, 255, 255, 0.55); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4);
      border: 1px solid rgba(255, 255, 255, 0.7); box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }
    .wall img { width: 100%; height: 100%; object-fit: cover; margin: 0; border-radius: 0; }
    .info {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem;
      padding: 1.5rem; text-align: center; color: #fff; background: rgba(0, 0, 0, 0.62); opacity: 0; z-index: 2; transition: opacity 0.3s;
    }
    .wall li:hover .info, .wall li:focus-within .info { opacity: 1; }
    .info .name { font-size: clamp(1.1rem, 1.9vw, 1.75rem); line-height: 1.15; letter-spacing: -0.03em; font-weight: 500; }
    .info .year { opacity: 0.7; }
    .wall li:hover .blank, .wall li:focus-within .blank { opacity: 0; }
    .blank { transition: opacity 0.2s; padding: 1.5rem; text-align: center; font-size: clamp(1.1rem, 1.9vw, 1.75rem); line-height: 1.15; letter-spacing: -0.03em; font-weight: 500; }
    .wall li.tone-0 { background: #e9dcd6; color: #000; }
    .wall li.tone-1 { background: #cfd6d9; color: #000; }
    .wall li.tone-2 { background: #1a1a1a; color: #fff; }
    .wall li.tone-3 { background: #dfe4d2; color: #000; }
    .wall li.tone-0 .blank, .wall li.tone-1 .blank, .wall li.tone-3 .blank { color: #000; }
    .wall li.tone-2 .blank { color: #fff; }
    @media (max-width: 1100px) { .wall { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 520px) { .wall { grid-template-columns: 1fr; } }
    #intro { min-height: 47vh; }
    #work { margin-bottom: 10rem; }
    #about, #contact { margin-bottom: 8rem; }
    #about h2, #contact h2 { margin-top: 0; }
    #about p { font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.35; letter-spacing: -0.02em; max-width: 46rem; }
  </style>
</Base>
