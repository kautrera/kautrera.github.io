---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(page);
const { title, date, role, tools } = page.data;
// The first image in the body becomes the hero; the in-body copy is hidden.
const hero = page.body?.match(/!\[[^\]]*\]\((\/images\/[^)\s]+)\)/)?.[1];
// Lead line: the ### right after the title in the markdown, shown beside the details instead of in the flow.
const lead = page.body?.match(/^# .*\n+### (.+)$/m)?.[1]?.replace(/\*+/g, '');
const meta = [
  ['Year', date.getFullYear()],
  ['Role', role],
  ['Tools', tools],
].filter(([, v]) => v);
---
<Base title={title}>
  <article class="case">
    <a class="back" href={`${base}/#work`}>&larr; Work</a>
    <p class="display" aria-hidden="true">{title}</p>
    <div class="split">
      <aside class="side">
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <dl>
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </aside>
      <div class="media">
        {hero && <img class="hero" src={base + hero} alt={title} />}
        <div class="prose"><Content /></div>
      </div>
    </div>
  </article>
  {hero && <style is:global set:html={`.case .prose img[src="${base}${hero}"]{display:none}`} />}

  <style>
    .case { padding-top: 2rem; }
    .back { color: var(--muted); text-decoration: none; }
    .back:hover { color: var(--fg); }
    .display {
      margin: 3rem 0 4rem; font-size: clamp(3.5rem, 13vw, 11rem); line-height: 0.9; letter-spacing: -0.05em; font-weight: 500;
      color: var(--muted); max-width: none; overflow-wrap: anywhere;
    }
    /* Details stay put on the left while the images scroll on the right. */
    .split { display: grid; grid-template-columns: 4fr 8fr; gap: 3rem; align-items: start; }
    .side { position: sticky; top: 2rem; }
    .side h1 { font-size: clamp(1.75rem, 3vw, 2.5rem); margin: 0 0 1rem; }
    .lead { color: var(--muted); font-size: 1.25rem; line-height: 1.35; letter-spacing: -0.02em; margin: 0 0 2rem; }
    dl { margin: 0; display: grid; gap: 1.25rem; }
    dt { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
    dd { margin: 0.15rem 0 0; }
    .media { min-width: 0; }
    .hero, .prose :global(img) { width: 100%; margin: 0 0 1.5rem; border-radius: 0; }
    .prose :global(h1), .prose :global(h1 + h3) { display: none; }
    .prose :global(h2) { font-size: clamp(1.75rem, 3.2vw, 3rem); margin: 3rem 0 1rem; }
    .prose :global(h3) { font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.3; letter-spacing: -0.02em; }

    /* Entrance motion: title slides up, details and images follow. */
    @keyframes rise { from { opacity: 0; transform: translateY(2.5rem); } to { opacity: 1; transform: none; } }
    @keyframes slide { from { opacity: 0; transform: translateX(-1.5rem); } to { opacity: 1; transform: none; } }
    .back { animation: slide 0.5s both; }
    .display { animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.05s both; }
    .side { animation: slide 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.25s both; }
    .hero { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s both; }
    .prose :global(img), .prose :global(p), .prose :global(h2), .prose :global(h3) {
      animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 35%;
    }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
    @media (max-width: 999px) {
      .split { grid-template-columns: 1fr; gap: 2rem; }
      .side { position: static; }
    }
  </style>
</Base>
