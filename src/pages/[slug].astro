---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(page);
const { title, date, role, tools } = page.data;
// The first image in the body becomes the hero; the in-body copy is hidden.
const hero = page.body?.match(/!\[[^\]]*\]\((\/images\/[^)\s]+)\)/)?.[1];
const meta = [
  ['Year', date.getFullYear()],
  ['Role', role],
  ['Tools', tools],
].filter(([, v]) => v);
---
<Base title={title}>
  <article class="case">
    <a class="back" href={`${base}/#work`}>&larr; Work</a>
    <p class="display" aria-hidden="true">{title}</p>
    <header class="top">
      <div class="side">
        <h1>{title}</h1>
        <dl>
          {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
      {hero && <img class="hero" src={base + hero} alt={title} />}
    </header>
    <div class="prose"><Content /></div>
  </article>
  {hero && <style is:global set:html={`.case .prose img[src="${base}${hero}"]{display:none}`} />}

  <style>
    .case { padding-top: 2rem; }
    .back { color: var(--muted); text-decoration: none; }
    .back:hover { color: var(--fg); }
    .display {
      margin: 3rem 0 2rem; font-size: clamp(3.5rem, 13vw, 11rem); line-height: 0.9; letter-spacing: -0.05em; font-weight: 500;
      color: var(--muted); max-width: none; overflow-wrap: anywhere;
    }
    .top { display: grid; grid-template-columns: 5fr 7fr; gap: 3rem; align-items: start; margin-bottom: 5rem; }
    .side h1 { font-size: clamp(1.75rem, 3vw, 2.5rem); margin: 0 0 2rem; }
    dl { margin: 0; display: grid; gap: 1.25rem; }
    dt { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
    dd { margin: 0.15rem 0 0; }
    .hero { width: 100%; margin: 0; border-radius: 0; }
    .prose :global(h1) { display: none; }
    .prose :global(h2) { font-size: clamp(1.75rem, 3.2vw, 3rem); margin-top: 5rem; }
    .prose :global(h3) { font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.3; letter-spacing: -0.02em; max-width: 46rem; }
    .prose :global(img) { width: 100%; margin: 3rem 0; border-radius: 0; }
    @media (max-width: 999px) { .top { grid-template-columns: 1fr; gap: 2rem; } }
  </style>
</Base>
