---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import RoadsterCase from '../components/RoadsterCase.astro';
import CustomAppsCase from '../components/CustomAppsCase.astro';
import TrueCarCase from '../components/TrueCarCase.astro';
import B2BCase from '../components/B2BCase.astro';
import { readFileSync, existsSync } from 'node:fs';
import '../styles/commerce-case.css';
import '../styles/studio-case.css';

// Protected pages: private sources exist locally only (gitignored). CI renders from the committed ciphertext.
const privateCases = import.meta.glob('../../private/*/*Case.astro', { eager: true }) as Record<string, any>;
const privateMeta = import.meta.glob('../../private/*/meta.json', { eager: true, import: 'default' }) as Record<string, any>;
const privateAssets = import.meta.glob('../../private/*/*.{webp,mp4}', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title, date, role, tools } = page.data;
// Same order as the wall, so "Next project" walks the tiles left to right.
const tour = ['custom-apps', 'roadster-1', 'bm-ux-studio', 'commerce-studio', 'truecar-1', 'b2b-commerce', 'clippit', 'photobucket', 'ello', 'blue-coat'];
const at = tour.indexOf(page.id);
const nextId = at > -1 ? tour[(at + 1) % tour.length] : null;
const body = page.body ?? '';
const gated = !!page.data.protected;
const dir = `../../private/${page.id}`;
const Private = Object.entries(privateCases).find(([k]) => k.startsWith(`${dir}/`))?.[1]?.default;
const meta = privateMeta[`${dir}/meta.json`];
const sealedFile = `${process.cwd()}/sealed/${page.id}.json`;
const sealed = gated && !Private && existsSync(sealedFile) ? readFileSync(sealedFile, 'utf8') : '';
const subtitle = meta?.subtitle ?? page.data.subtitle;

// The ### right after the title in the markdown doubles as the About text when none is set in front matter.
const lead = body.match(/^# .*\n+### (.+)$/m)?.[1]?.replace(/\*+/g, '');
const about = meta?.about ?? page.data.about ?? (lead ? [lead] : []);
// Gallery: front matter list, else the first image in the body. Its in-body copies are hidden below.
const first = body.match(/!\[[^\]]*\]\((\/images\/[^)\s]+)\)/)?.[1];
const gallerySrc = meta?.gallery ?? page.data.gallery ?? (first ? [first] : []);
// Items are a path or { src, caption }; private files resolve to built asset URLs.
const gallery = gallerySrc.map((g: any) => {
  const item = typeof g === 'string' ? { src: g } : g;
  return { ...item, url: meta ? privateAssets[`${dir}/${item.src}`] : base + item.src };
});
const Custom = page.id === 'roadster-1' ? RoadsterCase : page.id === 'custom-apps' ? CustomAppsCase : page.id === 'truecar-1' ? TrueCarCase : page.id === 'b2b-commerce' ? B2BCase : Private ?? null;
const rawFacts = meta?.facts ?? page.data.facts;
const facts = rawFacts && !rawFacts.some((f: any) => /^year$/i.test(f.label)) ? [...rawFacts, { label: 'Year', value: String(page.data.year ?? date.getFullYear()) }] : rawFacts;
const hasCase = gated || !!Custom || body.replace(/!\[[^\]]*\]\([^)]*\)/g, '').trim().length > 400;
const hideGallery = gated ? '' : gallery.map((g: any) => `.case .prose img[src="${g.url}"]`).join(',');
---
<Base title={title}>
  <article class="case">
    <div class="top">
      <a class="back" href={`${base}/#work`}>&larr; Work</a>
      {nextId && <a class="back next" href={`${base}/${nextId}/`}>Next project &rarr;</a>}
    </div>
    <p class="display" aria-hidden="true"><span>{`${title} `.repeat(6)}</span></p>
    <div id="gate-content">
    {Private && <Fragment set:html={'<!--gate:start-->'} />}
    {(!gated || Private) && (
    <div class="split">
      <aside class="side">
        <header>
          <h1>{title}</h1>
          {subtitle && <p class="subtitle">{subtitle}</p>}
        </header>
        {about.length > 0 && (
          <section>
            <h2 class="label">About</h2>
            {about.map((p) => <p class="story">{p}</p>)}
          </section>
        )}
        {facts ? (
          <div class="facts grid">
            {facts.map((f) => <div><h2 class="label">{f.label}</h2><p>{f.value}</p></div>)}
          </div>
        ) : (
        <div class="facts">
          <div class="col">
            {role && <div><h2 class="label">My role</h2><p>{role}</p></div>}
            <div><h2 class="label">Year</h2><p>{page.data.year ?? date.getFullYear()}</p></div>
          </div>
          {tools && <div class="col"><div><h2 class="label">Tools</h2><p>{tools}</p></div></div>}
        </div>
        )}
        {hasCase && <a class="pill" href="#case-study">View Case Study</a>}
      </aside>
      <div class:list={['gallery', { centered: page.id === 'b2b-commerce' }]}>
        {gallery.map((g: any) => g.caption
          ? <figure>{g.src.endsWith('.mp4')
              ? <video src={g.url} aria-label={g.caption} muted loop playsinline autoplay preload="auto"></video>
              : <img src={g.url} alt={g.caption} />}<figcaption>{g.caption}</figcaption></figure>
          : <img src={g.url} alt={title} />)}
      </div>
    </div>
    )}
    {hasCase && Custom && <section id="case-study" class="custom"><Custom /></section>}
    {hasCase && !Custom && !gated && <section id="case-study" class="prose"><Content /></section>}
    {hasCase && !Custom && !gated && (
      <dialog class="plb" aria-label="Enlarged image">
        <img alt="" />
        <button type="button" class="nav prev" aria-label="Previous image">&larr;</button>
        <button type="button" class="nav next" aria-label="Next image">&rarr;</button>
      </dialog>
    )}
    {Private && <Fragment set:html={'<!--gate:end-->'} />}
    </div>
    {gated && (
      <form id="gate" hidden>
        <label for="passcode">This case study is protected.</label>
        <p class="hint">Enter the passcode to view it.</p>
        <div class="row">
          <input id="passcode" type="password" autocomplete="current-password" required />
          <button type="submit">View</button>
        </div>
        <p class="err" role="alert" hidden>That passcode didn’t work.</p>
      </form>
      <script type="application/json" id="gate-data" set:html={sealed} />
    )}
  </article>
  <button type="button" class="totop" aria-label="Back to top">&uarr;</button>
  <style is:global>html { overflow-x: clip; }</style>
  {hideGallery && <style is:global set:html={`${hideGallery}{display:none}`} />}

  {gated && <script is:inline>
    // Decrypts the sealed case study in the browser (PBKDF2 + AES-GCM) and swaps it in.
    (async () => {
      const raw = document.getElementById('gate-data')?.textContent.trim();
      const form = document.getElementById('gate');
      if (!raw || !form) return;
      const data = JSON.parse(raw);
      const b64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
      const err = form.querySelector('.err');
      const open = async (pass) => {
        try {
          const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(pass), 'PBKDF2', false, ['deriveKey']);
          const key = await crypto.subtle.deriveKey(
            { name: 'PBKDF2', salt: b64(data.salt), iterations: data.iter, hash: 'SHA-256' },
            base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
          const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(data.iv) }, key, b64(data.ct));
          const host = document.getElementById('gate-content');
          host.innerHTML = new TextDecoder().decode(plain);
          // Scripts set via innerHTML don't run; swap in fresh copies so the page's own scripts start.
          host.querySelectorAll('script').forEach((old) => {
            const fresh = document.createElement('script');
            for (const a of old.attributes) fresh.setAttribute(a.name, a.value);
            fresh.textContent = old.textContent;
            old.replaceWith(fresh);
          });
          form.remove();
          sessionStorage.setItem('gate:' + location.pathname, pass);
          document.dispatchEvent(new Event('gate:open'));
          return true;
        } catch { return false; }
      };
      const saved = sessionStorage.getItem('gate:' + location.pathname);
      if (saved && (await open(saved))) return;
      form.hidden = false;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        err.hidden = true;
        const btn = form.querySelector('button');
        btn.disabled = true;
        if (!(await open(form.passcode.value))) { err.hidden = false; btn.disabled = false; form.passcode.select(); }
      });
    })();
  </script>}

  <script is:inline>
    // Images in a plain case study open in a lightbox.
    (() => {
      const lb = document.querySelector('.plb');
      if (!lb) return;
      const big = lb.querySelector('img'), prev = lb.querySelector('.prev'), next = lb.querySelector('.next');
      const imgs = [...document.querySelectorAll('.prose img')];
      let at = 0;
      const show = (i) => {
        at = (i + imgs.length) % imgs.length;
        big.src = imgs[at].currentSrc || imgs[at].src;
        big.alt = imgs[at].alt;
        prev.hidden = next.hidden = imgs.length < 2;
      };
      imgs.forEach((im, i) => {
        im.tabIndex = 0;
        im.style.cursor = 'zoom-in';
        im.setAttribute('role', 'button');
        im.setAttribute('aria-label', `Enlarge: ${im.alt || 'image'}`);
        const open = () => { show(i); lb.showModal(); };
        im.addEventListener('click', open);
        im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
      });
      prev.addEventListener('click', (e) => { e.stopPropagation(); show(at - 1); });
      next.addEventListener('click', (e) => { e.stopPropagation(); show(at + 1); });
      lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
      lb.addEventListener('click', () => lb.close());
    })();
    const totop = document.querySelector('.totop');
    const reveal = () => totop.classList.toggle('show', scrollY > 600);
    addEventListener('scroll', reveal, { passive: true });
    reveal();
    totop.addEventListener('click', () => scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }));
    // The big title drifts left as the page scrolls down.
    // Hero clip stays still for reduced-motion visitors.
    const still = () => { if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('.gallery video').forEach((v) => { v.pause(); v.controls = true; }); };
    still();
    document.addEventListener('gate:open', still);
    const drift = document.querySelector('.display span');
    if (drift && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const move = () => { drift.style.transform = `translateX(${-Math.min(scrollY, 1400)}px)`; };
      addEventListener('scroll', move, { passive: true });
      move();
    }
  </script>

  <style>
    .case { padding-top: 2rem; }
    .top { position: sticky; top: 0; z-index: 1; display: flex; justify-content: space-between; padding: 1rem 0; margin-bottom: 2rem; background: var(--bg); }
    /* Bar runs out to the right edge like the gallery, keeping its link inside the column. */
    @media (min-width: 1000px) {
      .top { --out: calc((100vw - min(1200px, 100vw - 26rem)) / 2); margin-right: calc(var(--out) * -1); padding-right: var(--out); }
    }
    .totop {
      position: fixed; right: 1.5rem; bottom: 1.5rem; z-index: 2; width: 3rem; height: 3rem; border: 0; border-radius: 50%;
      display: grid; place-items: center; background: var(--chip); color: var(--fg); font: inherit; font-size: 1.25rem; cursor: pointer;
      opacity: 0; pointer-events: none; transform: translateY(0.5rem); transition: opacity 0.25s, transform 0.25s;
    }
    .totop.show { opacity: 1; pointer-events: auto; transform: none; }
    .totop:hover, .totop:focus-visible { outline: 2px solid var(--fg); }
    .back { color: var(--muted); text-decoration: none; display: inline-block; }
    .back:hover { color: var(--fg); }

    .display {
      margin: 3rem 0 4rem; font-size: clamp(3.5rem, 13vw, 11rem); line-height: 0.9; letter-spacing: -0.05em; font-weight: 500;
      color: var(--muted); max-width: none; white-space: nowrap; overflow: hidden;
    }
    .display span { display: inline-block; }
    .display span { will-change: transform; }
    /* Gallery runs out to the right edge of the page. */
    @media (min-width: 1000px) {
      .gallery, .display { margin-right: calc((min(1200px, 100vw - 26rem) - 100vw) / 2); }
    }
    /* Details stay put on the left while the gallery scrolls on the right. */
    .split { display: grid; grid-template-columns: 4fr 8fr; gap: 3rem; align-items: start; }
    .side { position: sticky; top: 5rem; display: flex; flex-direction: column; gap: 1.5rem; }
    .side h1 { font-size: clamp(1.75rem, 2.6vw, 2.25rem); line-height: 1.1; letter-spacing: -0.03em; font-weight: 500; margin: 0 0 0.75rem; }
    .subtitle { margin: 0; color: var(--muted); max-width: none; }
    .label { margin: 0 0 0.5rem; font: inherit; font-size: 0.875rem; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
    .story { margin: 0 0 1.25rem; max-width: none; }
    .story:last-child { margin-bottom: 0; }
    .facts { display: flex; gap: 2rem; }
    .col { display: flex; flex-direction: column; gap: 2.5rem; }
    .facts p { margin: 0; max-width: 15rem; }
    .facts.grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
    .facts.grid p { max-width: none; }
    .custom { margin-top: 8rem; padding-top: 3rem; border-top: 1px solid var(--rule); scroll-margin-top: 2rem; }
    .pill {
      display: grid; place-items: center; height: 2.9rem; border: 2px solid var(--muted); border-radius: 28px;
      color: var(--fg); text-decoration: none; font-weight: 500; transition: border-color 0.2s;
    }
    .pill:hover, .pill:focus-visible { border-color: var(--fg); }

    .gallery { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .gallery img { width: 100%; height: auto; margin: 0; border-radius: 0; }
    .gallery figure { margin: 0; }
    .gallery video { width: 100%; height: auto; display: block; }
    .gallery figcaption { margin-top: 0.75rem; color: var(--muted); font-size: 0.875rem; }
    .gallery.centered figcaption { text-align: center; }
    #gate { max-width: 26rem; margin: 6rem 0 8rem; }
    #gate label { display: block; font-size: clamp(1.5rem, 2.6vw, 2.25rem); line-height: 1.1; letter-spacing: -0.03em; font-weight: 500; }
    #gate .hint { margin: 0.5rem 0 1.5rem; color: var(--muted); }
    #gate .row { display: flex; gap: 0.75rem; }
    #gate input { flex: 1; min-width: 0; height: 2.9rem; padding: 0 1rem; border: 2px solid var(--muted); border-radius: 28px; background: transparent; color: var(--fg); font: inherit; }
    #gate input:focus { outline: none; border-color: var(--fg); }
    #gate button { height: 2.9rem; padding: 0 1.5rem; border: 2px solid var(--muted); border-radius: 28px; background: transparent; color: var(--fg); font: inherit; font-weight: 500; cursor: pointer; }
    #gate button:hover:not(:disabled), #gate button:focus-visible { border-color: var(--fg); }
    #gate .err { margin: 0.75rem 0 0; color: #d33; }

    /* Full case study below the overview. */
    .prose { margin-top: 8rem; padding-top: 3rem; border-top: 1px solid var(--rule); scroll-margin-top: 2rem; }
    .prose > :global(h1:first-child), .prose > :global(h1:first-child + h3) { display: none; }
    .prose :global(h1) { font-size: clamp(1.75rem, 2.6vw, 2.25rem); line-height: 1.1; letter-spacing: -0.03em; font-weight: 500; margin: 5rem 0 1.5rem; }
    .prose :global(h3) { font-size: clamp(1.15rem, 1.8vw, 1.5rem); line-height: 1.35; letter-spacing: -0.02em; font-weight: 400; max-width: 46rem; }
    .prose :global(.band) { background: var(--chip); padding: 1px 3rem 3rem; margin: 5rem 0 0; }
    .prose :global(.band h1) { margin-top: 3rem; }
    .prose :global(img) { width: 100%; margin: 2rem 0; border-radius: 0; }

    .plb { padding: 0; border: 0; background: transparent; max-width: 94vw; max-height: 94vh; overflow: visible; }
    .plb::backdrop { background: rgba(0, 0, 0, 0.88); }
    .plb img { width: auto; max-width: 94vw; max-height: 94vh; margin: 0; cursor: zoom-out; background: #fff; border-radius: 0; }
    .plb .nav { position: fixed; top: 50%; transform: translateY(-50%); width: 3.25rem; height: 3.25rem; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.92); color: #000; font-size: 1.5rem; line-height: 1; cursor: pointer; }
    .plb .nav:hover, .plb .nav:focus-visible { background: #fff; outline: 2px solid #000; }
    .plb .nav[hidden] { display: none; }
    .plb .prev { left: 1.5rem; }
    .plb .next { right: 1.5rem; }

    /* Entrance motion: details slide in, gallery and case study rise as they arrive. */
    @keyframes rise { from { opacity: 0; transform: translateY(2.5rem); } to { opacity: 1; transform: none; } }
    @keyframes slide { from { opacity: 0; transform: translateX(-1.5rem); } to { opacity: 1; transform: none; } }
    .back { animation: slide 0.5s both; }
    .side { animation: slide 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both; }
    .gallery img { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both; }
    .gallery img + img { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 40%; }
    .prose :global(img), .prose :global(p), .prose :global(h1), .prose :global(h3) {
      animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 35%;
    }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
    @media (max-width: 999px) {
      .split { grid-template-columns: 1fr; gap: 2.5rem; }
      .side { position: static; }
      .top { top: 3.5rem; }
    }
  </style>
</Base>
