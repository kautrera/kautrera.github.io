---
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = [
  ['intro', 'Intro'],
  ['work', 'Work'],
  ['about', 'About'],
  ['contact', 'Contact'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Karen Utrera</title>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
    </script>
  </head>
  <body>
    <a class="mark" href={`${base}/`} aria-label="Karen Utrera, home">K</a>
    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
      <span></span><span></span>
    </button>
    <nav aria-label="Primary" id="menu">
      {sections.map(([id, label]) => <a href={`${base}/#${id}`} data-section={id}>{label}</a>)}
    </nav>
    <button class="theme" aria-label="Toggle light and dark theme" id="theme">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" />
      </svg>
    </button>
    <main><slot /></main>
    <script is:inline>
      // Highlight the nav item for the section in view (home page only).
      const links = new Map([...document.querySelectorAll('nav a[data-section]')].map((a) => [a.dataset.section, a]));
      const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean);
      if (targets.length) {
        const setActive = (id) => links.forEach((a, k) => a.classList.toggle('active', k === id));
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
          { rootMargin: '-35% 0px -60% 0px' },
        );
        targets.forEach((t) => io.observe(t));
        // The last section is short, so it may never reach the observer band; pin it at page bottom.
        addEventListener('scroll', () => {
          if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) setActive(targets[targets.length - 1].id);
        }, { passive: true });
        setActive(targets[0].id);
      }
      const burger = document.getElementById('burger');
      const setMenu = (open) => {
        document.body.classList.toggle('menu-open', open);
        burger.setAttribute('aria-expanded', open);
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      };
      burger.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
      document.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
      document.getElementById('theme').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = (root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
        root.dataset.theme = dark ? 'light' : 'dark';
        localStorage.setItem('theme', root.dataset.theme);
      });
    </script>
    <style is:global>
      :root { --fg: #000; --muted: #a3a3a3; --bg: #fff; --chip: #f0f0f0; --rule: #e6e6e6; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) { --fg: #fff; --muted: #777; --bg: #0b0b0b; --chip: #1c1c1c; --rule: #262626; }
      }
      :root[data-theme='dark'] { --fg: #fff; --muted: #777; --bg: #0b0b0b; --chip: #1c1c1c; --rule: #262626; }

      /* Cross-page transition; fixed chrome keeps its own layer so only the content animates. */
      @view-transition { navigation: auto; }
      .mark { view-transition-name: mark; }
      nav { view-transition-name: nav; }
      .theme { view-transition-name: theme; }
      main { view-transition-name: page; }
      ::view-transition-old(page) { animation: 0.25s ease both fade-out; }
      ::view-transition-new(page) { animation: 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both fade-up; }
      @keyframes fade-out { to { opacity: 0; transform: translateY(-0.75rem); } }
      @keyframes fade-up { from { opacity: 0; transform: translateY(1.5rem); } }
      @media (prefers-reduced-motion: reduce) { ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; } }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      section[id] { scroll-margin-top: 6rem; }
      body {
        margin: 0;
        font-family: 'Inter', 'Helvetica Neue', system-ui, -apple-system, sans-serif;
        font-size: 1.125rem;
        line-height: 1.5;
        letter-spacing: -0.01em;
        color: var(--fg);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }

      .mark { position: fixed; top: 2rem; left: 2.75rem; font-size: 1.75rem; text-decoration: none; line-height: 1; z-index: 2; }
      nav { position: fixed; top: 22vh; left: 2.75rem; display: flex; flex-direction: column; z-index: 2; }
      nav a { color: var(--muted); text-decoration: none; line-height: 1.55; transition: color 0.15s; }
      nav a:hover, nav a.active { color: var(--fg); }
      .theme {
        position: fixed; left: 1.75rem; bottom: 2rem; width: 3rem; height: 3rem; border-radius: 50%;
        border: 0; background: var(--chip); color: var(--fg); display: grid; place-items: center; cursor: pointer; z-index: 2;
      }

      main { width: min(1200px, 100% - 26rem); margin: 0 auto; padding: 22vh 0 8rem; }
      main h1 { font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 1.02; letter-spacing: -0.04em; font-weight: 500; margin: 0 0 3rem; }
      main h2 { font-size: clamp(1.75rem, 3.2vw, 3rem); line-height: 1.1; letter-spacing: -0.03em; font-weight: 500; margin: 4rem 0 1rem; }
      main h3 { font-weight: 500; margin: 2.5rem 0 0.5rem; }
      main p, main li { max-width: 42rem; }
      main img { max-width: 100%; height: auto; display: block; margin: 2rem 0; border-radius: 6px; }
      main a { text-underline-offset: 0.2em; text-decoration-thickness: 1px; }

      .eyebrow { color: var(--muted); margin: 0 0 0.5rem; }
      .work { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
      .work li { max-width: none; border-bottom: 1px solid var(--rule); }
      .work a {
        display: flex; justify-content: space-between; gap: 2rem; align-items: baseline; padding: 1.5rem 0;
        font-size: clamp(1.5rem, 2.8vw, 2.5rem); letter-spacing: -0.03em; text-decoration: none; color: var(--fg); transition: color 0.15s;
      }
      .work:hover a { color: var(--muted); }
      .work a:hover { color: var(--fg); }
      .work time { font-size: 1.125rem; letter-spacing: -0.01em; color: var(--muted); }

      .burger { display: none; }

      @media (max-width: 999px) {
        .mark { left: 1.25rem; top: 1.25rem; z-index: 4; }
        .burger {
          position: fixed; top: 0.75rem; right: 0.75rem; z-index: 4; width: 3rem; height: 3rem; border: 0; padding: 0;
          background: none; color: var(--fg); cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;
        }
        .burger span { width: 1.5rem; height: 1.5px; background: currentColor; transition: transform 0.25s; }
        .menu-open .burger span:first-child { transform: translateY(4.75px) rotate(45deg); }
        .menu-open .burger span:last-child { transform: translateY(-4.75px) rotate(-45deg); }
        nav {
          position: fixed; inset: 0; z-index: 3; background: var(--bg); padding: 6rem 1.25rem 2rem; gap: 0.25rem;
          opacity: 0; visibility: hidden; transition: opacity 0.2s, visibility 0.2s;
        }
        .menu-open nav { opacity: 1; visibility: visible; }
        nav a { font-size: clamp(2.25rem, 9vw, 4rem); letter-spacing: -0.04em; line-height: 1.1; }
        .theme { left: 1.25rem; bottom: 1.25rem; z-index: 4; }
        main { width: auto; margin: 0; padding: 9rem 1.25rem 6rem; }
      }
    </style>
  </body>
</html>
